{
    "name": "bsadeknet/authz-client",
    "version": "1.0.0",
    "description": "Library PHP untuk remote token introspection/decrypt ke Laravel Passport Authz Server",
    "type": "library",
    "license": "MIT",
    "keywords": ["passport", "symfony", "laravel"],
    "authors": [
        {
            "name": "bsadeknet",
            "email": "sadek.tabrani@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "symfony/http-foundation": "^7.4|^8.1",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/http-client": "^7.4|^8.1"
    },
    "autoload": {
        "psr-4": {
            "Bsadeknet\\AuthzClient\\": "src/"
        }
    },
    "scripts": {
        "actions": "composer test",
        "test": "/usr/bin/php8.4 ./vendor/bin/phpunit tests/Unit",
        "test:integration": "/usr/bin/php8.4 ./vendor/bin/phpunit tests/Integration"
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Bsadeknet\\AuthzClient\\Providers\\AuthzServiceProvider"
            ]
        }
    }
}
